# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# Number of reverse proxies in front of the API (for correct client IPs in rate limiting). 0 locally.
TRUST_PROXY=0
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
# Public base URL of this API (used to build image URLs).
PUBLIC_API_URL=http://localhost:4000

# ─── Database (Neon in production) ───────────────────────────────────────────
# Pooled connection for the app (Neon: the "-pooler" host, add ?pgbouncer=true&connection_limit=10)
DATABASE_URL=postgresql://auctionride:auctionride@localhost:5433/auctionride?schema=public
# Direct connection for migrations
DIRECT_URL=postgresql://auctionride:auctionride@localhost:5433/auctionride?schema=public

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
# lax when frontend and API share a site; none (requires HTTPS) when they are cross-site.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# ─── Auctions ────────────────────────────────────────────────────────────────
SOFT_CLOSE_WINDOW_SECONDS=60
SOFT_CLOSE_EXTENSION_SECONDS=60
MAX_SOFT_CLOSE_EXTENSIONS=10
ARCHIVE_AFTER_HOURS=168

# ─── Workers ─────────────────────────────────────────────────────────────────
# Run BullMQ workers inside the API process. Set false when deploying a dedicated worker.
RUN_WORKERS=true
WORKER_CONCURRENCY=10

# ─── Uploads ─────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# ─── Seed (development only) ─────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@auctionride.dev
SEED_ADMIN_PASSWORD=Admin@12345
